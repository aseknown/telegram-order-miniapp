BOT_TOKEN=123456789:YOUR_BOT_TOKEN
ADMIN_TELEGRAM_ID=123456789
PUBLIC_URL=https://your-app.example.com
DATABASE_URL=postgresql://user:password@host:5432/database

# What customers see on the payment page
PAYMENT_TITLE=Bank card transfer
CARD_HOLDER=Your Name
CARD_NUMBER=0000 0000 0000 0000
PAYMENT_NOTE=Transfer the exact amount, then upload a screenshot. Your order is delivered only after manual verification.

# Optional: PostgreSQL providers often require TLS in production
PGSSL=true

# 24 hours by default. Rejects stale Telegram Mini App authentication data.
INIT_DATA_MAX_AGE_SECONDS=86400
