{
  "name": "telegram-order-cloudflare-pages",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public",
    "db:local": "wrangler d1 execute telegram-orders --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute telegram-orders --remote --file=./migrations/0001_init.sql",
    "deploy": "wrangler pages deploy public --project-name=telegram-order-shop",
    "cf:setup": "bash scripts/setup-cloudflare.sh",
    "cf:secrets": "bash scripts/set-secrets.sh",
    "cf:webhook": "bash scripts/set-webhook.sh",
    "cf:deploy": "bash scripts/deploy.sh",
    "db:local:persist": "bash scripts/local-db.sh"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
